
public class Main {
    public static void main(String[] args) {

        int n = 10000;

        // Original Solution
        long start = System.nanoTime();

        String s = "";

        for (int i = 0; i < n; i++) {
            s = s + "Ticket";
        }

        long end = System.nanoTime();

        long stringTime = end - start;

        // Redesigned Solution
        start = System.nanoTime();

        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < n; i++) {
            sb.append("Ticket");
        }

        end = System.nanoTime();

        long builderTime = end - start;

        System.out.println("String Time: " + stringTime);
        System.out.println("StringBuilder Time: " + builderTime);

        System.out.println("String Length: " + s.length());
        System.out.println("Builder Length: " + sb.length());
    }
}
