
import java.sql.*;

public class TransactionTest {

    public static void main(String[] args) throws Exception {

        String url = "jdbc:mysql://localhost:3306/assignment5";

        try (Connection con =
                     DriverManager.getConnection(url, "root",
                             "your_mysql_password")) {

            con.setAutoCommit(false);

            String sql = "INSERT INTO bus_pass VALUES (?, ?, ?, ?, ?)";

            try (PreparedStatement ps = con.prepareStatement(sql)) {

                for (int i = 1; i <= 10; i++) {

                    ps.setString(1, "T" + i);
                    ps.setString(2, "R" + i);
                    ps.setString(3, "Student" + i);
                    ps.setInt(4, 10);

                    if (i == 5)
                        ps.setDouble(5, -1);
                    else
                        ps.setDouble(5, 4500);

                    ps.executeUpdate();
                }

                con.commit();

            } catch (SQLException e) {

                con.rollback();
                System.out.println("Failure detected. Rollback completed.");
            }

            con.setAutoCommit(true);

            try (Statement st = con.createStatement();
                 ResultSet rs = st.executeQuery(
                         "SELECT COUNT(*) FROM bus_pass WHERE pass_id LIKE 'T%'")) {

                if (rs.next())
                    System.out.println("Remaining records: " +
                            rs.getInt(1));
            }
        }
    }
}
