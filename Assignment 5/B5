
import java.sql.*;
import java.util.*;

public class PassLoader {

    public static int loadAll(Connection con,
                              List<String[]> passes)
            throws SQLException {

        String sql = "INSERT INTO bus_pass " +
                "(pass_id, reg_no, name, route_no, amount) " +
                "VALUES (?, ?, ?, ?, ?)";

        boolean oldAutoCommit = con.getAutoCommit();
        con.setAutoCommit(false);

        try (PreparedStatement ps = con.prepareStatement(sql)) {

            int n = 0;

            for (String[] p : passes) {

                ps.setString(1, p[0]);
                ps.setString(2, p[1]);
                ps.setString(3, p[2]);
                ps.setInt(4, Integer.parseInt(p[3]));
                ps.setDouble(5, Double.parseDouble(p[4]));

                ps.addBatch();
                n++;

                if (n % 1000 == 0) {
                    ps.executeBatch();
                    ps.clearBatch();
                }
            }

            ps.executeBatch();
            ps.clearBatch();

            con.commit();

            return n;

        } catch (SQLException | RuntimeException e) {

            con.rollback();
            throw e;

        } finally {
            con.setAutoCommit(oldAutoCommit);
        }
    }

    public static void main(String[] args) {

        String url = "jdbc:mysql://localhost:3306/assignment5";
        String user = "root";
        String password = "your_mysql_password";

        try (Connection con =
                     DriverManager.getConnection(url, user, password)) {

            for (int size : new int[]{1000, 10000, 100000}) {

                try (Statement st = con.createStatement()) {
                    st.executeUpdate("DELETE FROM bus_pass");
                }

                List<String[]> passes = new ArrayList<>();

                for (int i = 1; i <= size; i++) {
                    passes.add(new String[]{
                            "P" + size + "_" + i,
                            "REG" + i,
                            "Student" + i,
                            String.valueOf((i % 20) + 1),
                            "4500.0"
                    });
                }

                long start = System.nanoTime();

                int count = loadAll(con, passes);

                long end = System.nanoTime();

                System.out.println("Records: " + count);
                System.out.println("Time: " +
                        (end - start) / 1_000_000.0 + " ms");
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
